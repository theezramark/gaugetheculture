// Cloudflare Workers settings.
// Static pages come from ./dist (built by `astro build`).
// Only /api/* runs the small server in worker/index.ts (the signup form).
//
// Secrets are NOT in this file. Add them in the dashboard
// (Worker > Settings > Variables and Secrets, type "Secret"):
//   RESEND_SEND_KEY, RESEND_CONTACTS_KEY, RESEND_SEGMENT_ID, TURNSTILE_SECRET, SIGNING_KEY
{
  "name": "gaugetheculture",
  "compatibility_date": "2026-11-09",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
