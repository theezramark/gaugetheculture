---
// An issue's perforated stamp cover. The parent decides the size and the panel behind it.
import type { Issue } from '../lib/issues';
import { pad, STAMP_NUMBER_COLOR } from '../lib/issues';

interface Props { issue: Issue; eager?: boolean }
const { issue, eager = false } = Astro.props;
const { number, topic, cover } = issue.data;
---
{cover && (
  <div class="stamp">
    <img src={cover} alt={`Stamp cover for issue ${number}, ${topic}`} width="400" height="500" loading={eager ? 'eager' : 'lazy'} />
    <span class="stamp__num" style={`color:${STAMP_NUMBER_COLOR[topic]}`} aria-hidden="true">{pad(number)}</span>
  </div>
)}
