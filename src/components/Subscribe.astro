---
// Signup band. The form is not connected yet: Step 4 adds a Cloudflare Worker at /api/subscribe
// with Turnstile (bot check) and double opt-in. Until then the button does nothing.
---
<section id="subscribe" class="band" aria-labelledby="subscribe-title">
  <div class="wrap band__inner">
    <img src="/stamp.svg" alt="" width="70" height="75" />
    <p class="kicker">The newsletter</p>
    <h2 id="subscribe-title" class="hed band__title">One essay, every other Sunday.</h2>
    <p class="dek band__text">Long opinions on television, film, books, music and the world, sent to your inbox. Every issue also lives here.</p>
    <form class="signup" method="post" action="/api/subscribe">
      <label class="visually-hidden" for="signup-email">Email address</label>
      <input id="signup-email" name="email" type="email" autocomplete="email" required placeholder="Your email address" />
      <button type="submit">Subscribe</button>
    </form>
    <p class="meta">Free. We only store your email. Unsubscribe any time.</p>
  </div>
</section>

<style>
  .band { margin-top: clamp(72px, 9vw, 128px); background: var(--surf2); border-block: 1px solid var(--line); }
  .band__inner {
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: 14px;
    padding-block: clamp(48px, 6vw, 88px);
  }
  .band__inner .kicker { margin-top: 8px; }
  .band__title { font-size: clamp(40px, 4.6vw, 60px); line-height: 1.04; }
  .band__text { font-size: 19px; max-width: 520px; }
  .signup { margin-top: 14px; }
</style>
