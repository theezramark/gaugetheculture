---
// Signup. Posts to /api/subscribe (worker/index.ts): Turnstile bot check, then a confirm email.
// The Turnstile SITE key is public (every visitor's browser receives it), so it lives here in the code.
// The SECRET key is never in code: it is the TURNSTILE_SECRET secret in Cloudflare.
// In local dev, Cloudflare's official test key is used, which always passes.
// LEGAL: the words a reader sees here are recorded as FORM_TEXT_VERSION in worker/index.ts and
// in legal/consent-versions.md. If you change the consent wording, add a new version there.
const siteKey = import.meta.env.DEV ? '1x00000000000000000000AA' : '0x4AAAAAAF7XoexwEX-7sPM9';
---
<div id="subscribe" class="grid closing__close" aria-labelledby="subscribe-title" role="region">
  <div class="closing__copy">
    <img class="stamp-mark" src="/stamp.svg" alt="" width="64" height="69" />
    <h2 id="subscribe-title" class="hed h2">Get the Sunday essay by email.</h2>
    <p class="lead sec-intro">One long opinion piece every other Sunday on television, film, books, music and the world. Free, and every issue also lives on this site.</p>
  </div>
  <div class="closing__form">
    <form class="form signup-form" method="post" action="/api/subscribe">
      <label class="field__label" for="signup-email">Email address</label>
      <div class="field__row">
        <input class="field__input" id="signup-email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@example.com" />
        <button class="btn" type="submit" data-signup-submit disabled>Subscribe free</button>
      </div>
      <!-- Honeypot: hidden from people, bots fill it in. -->
      <div class="hp" aria-hidden="true">
        <label for="signup-website">Leave this empty</label>
        <input id="signup-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <div class="cf-turnstile" data-sitekey={siteKey} data-action="subscribe" data-theme="auto" data-size="flexible"
        data-callback="gtcTurnstileOk" data-expired-callback="gtcTurnstileReset" data-error-callback="gtcTurnstileReset"></div>
      <p class="meta" data-signup-hint>The Subscribe button works once the quick check above finishes.</p>
    </form>
    <p class="meta form__note">Free. We only store your email. You'll get one email to confirm. Unsubscribe any time. Details in our <a href="/privacy/">privacy policy</a>.</p>
  </div>
</div>
<script is:inline src="/signup.js"></script>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
