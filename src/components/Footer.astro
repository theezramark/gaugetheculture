---
// The closing block on every page: row 1 the signup (or a short line), row 2 the directory and legal row.
import Wordmark from './Wordmark.astro';
import Subscribe from './Subscribe.astro';

interface Props { signup?: boolean }
const { signup = true } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="closing">
  <div class="wrap">
    {signup ? <Subscribe /> : null}

    <div class={signup ? 'closing__dir' : ''}>
      <div class="grid">
        <div class="dir__brand">
          <a class="dir__logo" href="/" aria-label="Gauge the Culture, home">
            <img src="/mark.svg" alt="" width="44" height="44" />
            <Wordmark size={30} />
          </a>
          <p class="dek">One long opinion essay on culture, every other Sunday.</p>
        </div>
        <div class="dir__col">
          <h3>Read</h3>
          <a href="/">Latest issue</a>
          <a href="/archive/">Archive</a>
          <a href="/about/">About</a>
        </div>
        <div class="dir__col">
          <h3>Contact</h3>
          <a href="mailto:hello@gaugetheculture.com">Email us</a>
        </div>
        <div class="dir__col">
          <h3>Legal</h3>
          <a href="/privacy/">Privacy</a>
          <a href="/impressum/">Impressum</a>
        </div>
      </div>
      <div class="dir__legal">
        <span>© {year} Gauge the Culture</span>
        <span>No ads, no tracking.</span>
      </div>
    </div>
  </div>
</footer>
