---
import Wordmark from './Wordmark.astro';

interface Props { active?: string }
const { active = '' } = Astro.props;
const links = [
  { label: 'Issues', href: '/' },
  { label: 'Archive', href: '/archive/' },
  { label: 'About', href: '/about/' },
];
---
<header class="nav">
  <div class="nav__inner">
    <nav class="nav__links" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={l.label === active ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <a class="nav__brand" href="/" aria-label="Gauge the Culture, home">
      <img src="/mark.svg" alt="" width="34" height="34" />
      <Wordmark size={23} />
    </a>

    <div class="nav__right">
      <button class="iconbtn" type="button" data-theme-toggle aria-label="Switch light or dark mode">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a9 9 0 1 0 0 18z" fill="currentColor"></path>
          <circle cx="12" cy="12" r="9"></circle>
        </svg>
      </button>
      <a class="btn btn--small" href="#subscribe">Subscribe</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 60;
    background: var(--nav-bg);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
    border-bottom: 1px solid var(--line);
  }
  .nav__inner {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px;
    max-width: var(--max); height: 68px; margin-inline: auto; padding-inline: var(--gutter);
  }
  .nav__links { display: flex; gap: 26px; }
  .nav__links a {
    font-family: var(--sans); font-weight: 500; font-size: 13.5px; color: var(--tx2);
    text-decoration: none; padding: 6px 0;
  }
  .nav__links a[aria-current='page'] { color: var(--tx); box-shadow: inset 0 -2px 0 var(--tx); }
  .nav__brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .nav__right { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }

  @media (max-width: 860px) {
    .nav__inner { grid-template-columns: auto 1fr; height: 60px; }
    .nav__links { display: none; }
    .nav__brand img { width: 30px; height: 30px; }
  }
</style>
