---
// Translucent sticky bar: logo on the left line, three words, theme switch, the main action.
// Under 1024 px the words move into a full-screen sheet behind the menu button (public/site.js).
import Wordmark from './Wordmark.astro';

interface Props { active?: string; subscribeHref?: string }
const { active = '', subscribeHref = '#subscribe' } = Astro.props;
const links = [
  { label: 'Issues', href: '/' },
  { label: 'Archive', href: '/archive/' },
  { label: 'About', href: '/about/' },
];
const themeIcon = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18z" fill="currentColor"></path><circle cx="12" cy="12" r="9"></circle></svg>';
---
<header class="nav">
  <div class="wrap nav__inner">
    <a class="nav__brand" href="/" aria-label="Gauge the Culture, home">
      <img src="/mark.svg" alt="" width="36" height="36" />
      <Wordmark size={23} />
    </a>

    <nav class="nav__links" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={l.label === active ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="nav__right">
      <button class="iconbtn nav__theme" type="button" data-theme-toggle aria-label="Switch light or dark mode" set:html={themeIcon} />
      <a class="btn nav__cta" href={subscribeHref}>Subscribe free</a>
      <button class="iconbtn nav__toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="menu-sheet" aria-label="Open menu">
        <svg class="i-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"></path></svg>
        <svg class="i-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
  </div>
</header>

<div class="sheet" id="menu-sheet">
  <nav class="wrap" aria-label="Menu">
    <ul>
      {links.map((l) => (
        <li><a href={l.href} aria-current={l.label === active ? 'page' : undefined}>{l.label}</a></li>
      ))}
      <li><button type="button" data-theme-toggle>Light or dark <span set:html={themeIcon} /></button></li>
    </ul>
    <a class="btn" href={subscribeHref}>Subscribe free</a>
  </nav>
</div>
