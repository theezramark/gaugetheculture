---
// Home page. One section per screen on desktop:
// 1 hero (what this is, the latest issue) · 2 the latest essay's opening · 3 the statement (scroll moment)
// · 4 issues and topics · then the closing block (signup + footer) from Base.
import Base from '../layouts/Base.astro';
import Stamp from '../components/Stamp.astro';
import { getIssues, issueUrl, formatDate, excerpt, pullQuote, ARROW } from '../lib/issues';
import { TOPICS } from '../content.config';

const issues = await getIssues();
const lead = issues[0];
const shelf = issues.slice(0, 4);
const opening = lead ? excerpt(lead, 2) : [];
const quote = lead ? pullQuote(lead) : undefined;
const topicCounts = TOPICS.map((t) => ({ topic: t, count: issues.filter((i) => i.data.topic === t).length }));
const slug = (t: string) => t.toLowerCase().replace(/[^a-z]+/g, '-');
---
<Base active="Issues">
  <section class="hero" data-enter aria-labelledby="hero-title">
    <div class="wrap">
      <div class="hero__text">
        <p class="label label--acc" data-enter-item>Every other Sunday · Free</p>
        <h1 id="hero-title" class="hed h1 hero__h1">The culture newsletter for close readers</h1>
        <p class="lead hero__lead" data-enter-item>One long opinion essay on television, film, books, music or the world, and what it says about how we live now. In your inbox, and in full on this site.</p>
        <div class="btn-row" data-enter-item>
          <a class="btn" href="#subscribe">Subscribe free</a>
          {lead && <a class="btn btn--secondary" href={issueUrl(lead)}>Read issue {lead.data.number}</a>}
        </div>
      </div>
      {lead && (
        <div class="hero__issue" data-enter-media>
          <a class="card issue-card" href={issueUrl(lead)} aria-label={`Issue ${lead.data.number}: ${lead.data.title}`}>
            <div class="card__media"><Stamp issue={lead} eager /></div>
            <div class="card__body">
              <p class="label">No. {lead.data.number} · {lead.data.topic} · {formatDate(lead.data.date)}</p>
              <h2 class="hed issue-card__title">{lead.data.title}</h2>
              <p class="issue-card__dek">{lead.data.dek}</p>
              <span class="issue-card__go">Read the essay <Fragment set:html={ARROW} /></span>
            </div>
          </a>
        </div>
      )}
    </div>
  </section>

  {lead && opening.length > 0 && (
    <section class="screen ground-alt" aria-labelledby="opening-title">
      <div class="wrap">
        <p class="label">From the latest issue</p>
        <h2 id="opening-title" class="hed h2 sec-title">{lead.data.title}</h2>
        <div class="grid excerpt">
          <div class="excerpt__text">
            {opening.map((p) => <p>{p}</p>)}
            <div class="btn-row">
              <a class="btn btn--secondary" href={issueUrl(lead)}>Read the full essay</a>
              <span class="meta">{lead.data.readMinutes} min read</span>
            </div>
          </div>
          {quote && (
            <blockquote class="excerpt__quote">
              <p>{quote}</p>
              <footer class="label">From No. {lead.data.number}</footer>
            </blockquote>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="screen" aria-labelledby="what-title">
    <div class="wrap">
      <h2 id="what-title" class="label">What you get</h2>
      <p class="statement" data-statement>Culture reflects its moment, and it also measures it. Each issue takes one reading, from a show, a book, a film or an election, and asks what it says about the way we live now.</p>
      <ul class="grid facts">
        <li><strong>One essay</strong><span>Every other Sunday morning, about a 12 minute read.</span></li>
        <li><strong>Six topics</strong><span>Television, film, books, music, politics and the world.</span></li>
        <li><strong>Free to read</strong><span>No ads and no tracking. Every issue stays on this site.</span></li>
      </ul>
    </div>
  </section>

  <section class="screen ground-alt" aria-labelledby="shelf-title">
    <div class="wrap">
      <h2 id="shelf-title" class="hed h2">Recent issues and topics</h2>
      <p class="sec-intro">Start with the newest essay, or pick a subject.</p>
      <div class="grid shelf sec-body">
        <ul class="shelf__list">
          {shelf.map((i) => (
            <li>
              <a class="row" href={issueUrl(i)}>
                <span class="row__thumb"><Stamp issue={i} /></span>
                <span>
                  <span class="label">No. {i.data.number} · {i.data.topic} · {formatDate(i.data.date)}</span>
                  <span class="row__title">{i.data.title}</span>
                  <span class="row__dek">{i.data.dek}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <div class="shelf__topics">
          <h3 class="label">Topics</h3>
          <nav class="topics" aria-label="Topics">
            {topicCounts.map(({ topic, count }) => (
              <a href={`/archive/#${slug(topic)}`}>
                <span class="t-name">{topic}</span>
                <span class="meta">{count} {count === 1 ? 'issue' : 'issues'}</span>
              </a>
            ))}
          </nav>
          <p class="shelf__more"><a class="link link--arrow" href="/archive/">See every issue <Fragment set:html={ARROW} /></a></p>
        </div>
      </div>
    </div>
  </section>
</Base>
