---
import Base from '../layouts/Base.astro';
import Stamp from '../components/Stamp.astro';
import { getIssues, issueUrl, formatDate } from '../lib/issues';
import { TOPICS } from '../content.config';

const issues = await getIssues();
// Group by year, newest first.
const years = [...new Set(issues.map((i) => i.data.date.getUTCFullYear()))].sort((a, b) => b - a);
const slug = (t: string) => t.toLowerCase().replace(/[^a-z]+/g, '-');
const byTopic = TOPICS.map((t) => ({ topic: t, list: issues.filter((i) => i.data.topic === t) }));
---
<Base title="Archive" description="Every issue of Gauge the Culture, newest first, by year and by topic." active="Archive">
  <section class="wrap page-head">
    <p class="label">Archive</p>
    <h1 class="hed h1">Every issue, newest first</h1>
    <p class="lead">{issues.length} {issues.length === 1 ? 'essay' : 'essays'} so far. Each one is the full web version of the email.</p>
    <ul class="topic-filter" aria-label="Jump to a topic">
      {byTopic.map(({ topic, list }) => (
        <li><a href={`#${slug(topic)}`} class={list.length === 0 ? 'is-empty' : undefined}>{topic} · {list.length}</a></li>
      ))}
    </ul>
  </section>

  {years.map((year) => {
    const list = issues.filter((i) => i.data.date.getUTCFullYear() === year);
    return (
      <section class="wrap year" aria-labelledby={`y-${year}`}>
        <div class="year__head">
          <h2 id={`y-${year}`} class="hed h2">{year}</h2>
          <p class="meta">{list.length} {list.length === 1 ? 'issue' : 'issues'}</p>
        </div>
        <ul class="archive-list">
          {list.map((i) => (
            <li>
              <a class="row" href={issueUrl(i)}>
                <span class="row__thumb"><Stamp issue={i} /></span>
                <span>
                  <span class="label">No. {i.data.number} · {i.data.topic}</span>
                  <span class="row__title">{i.data.title}</span>
                  <span class="row__dek">{i.data.dek}</span>
                </span>
                <span class="row__side meta">{formatDate(i.data.date)}<br />{i.data.readMinutes} min read</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    );
  })}

  <section class="wrap by-topic" aria-labelledby="topics-title">
    <h2 id="topics-title" class="hed h2">Issues by topic</h2>
    <div class="grid by-topic__grid">
      {byTopic.map(({ topic, list }) => (
        <div class="by-topic__item" id={slug(topic)}>
          <h3 class="hed h3">{topic}</h3>
          {list.length > 0 ? (
            <ul>{list.map((i) => <li><a class="link" href={issueUrl(i)}>No. {i.data.number}: {i.data.title}</a></li>)}</ul>
          ) : (
            <p class="meta" style="margin-top:12px">No issues on this topic yet.</p>
          )}
        </div>
      ))}
    </div>
  </section>
</Base>
