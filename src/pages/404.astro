---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" signup={false}>
  <section class="wrap notice">
    <p class="label">Error 404</p>
    <h1 class="hed h1">This page isn’t here</h1>
    <p class="lead">It may have moved. Every issue is in the archive.</p>
    <div class="btn-row"><a class="btn" href="/archive/">Open the archive</a></div>
  </section>
</Base>
