---
// One page per issue: /issues/<file-name>/
// Text column on the left line, a details card on the right (above the text on phones).
import Base from '../../layouts/Base.astro';
import Stamp from '../../components/Stamp.astro';
import { render } from 'astro:content';
import { getIssues, issueUrl, formatDate, ARROW, type Issue } from '../../lib/issues';

export async function getStaticPaths() {
  const issues = await getIssues();
  return issues.map((issue) => ({ params: { slug: issue.id }, props: { issue } }));
}

interface Props { issue: Issue }
const { issue } = Astro.props;
const { Content } = await render(issue);
const d = issue.data;
const others = (await getIssues()).filter((i) => i.id !== issue.id).slice(0, 3);
const iso = d.date.toISOString().slice(0, 10);
---
<Base title={d.title} description={d.dek} active="Issues">
  <article>
    <header class="wrap article-head">
      <p class="article-head__crumbs">
        <a href="/archive/">Archive</a>
        <span class="meta" aria-hidden="true">/</span>
        <span class="label label--acc">No. {d.number} · {d.topic}</span>
      </p>
      <h1 class="hed h1">{d.title}</h1>
      <p class="lead">{d.dek}</p>
      <p class="meta byline">
        <img src="/mark.svg" alt="" width="40" height="40" />
        <span><strong>By Gauge the Culture</strong> · <time datetime={iso}>{formatDate(d.date)}</time> · {d.readMinutes} min read</span>
      </p>
    </header>

    <div class="wrap grid article">
      <div class="article__body">
        <div class="prose prose--essay">
          <Content />
        </div>

        <aside class="reply" aria-labelledby="reply-title">
          <h2 id="reply-title" class="hed h3">Did this one land? Argue back.</h2>
          <p class="dek">Reply to the email or write to us. The best replies are quoted in the next issue.</p>
          <div class="btn-row"><a class="btn btn--secondary" href={`mailto:hello@gaugetheculture.com?subject=${encodeURIComponent('Re: ' + d.title)}`}>Email a reply</a></div>
        </aside>
      </div>

      <aside class="article__rail" aria-label="About this issue">
        <div class="card rail-card">
          <div class="card__media"><Stamp issue={issue} eager /></div>
          <div class="card__body">
            <dl>
              <dt>Issue</dt><dd>No. {d.number}</dd>
              <dt>Topic</dt><dd>{d.topic}</dd>
              <dt>Published</dt><dd>{formatDate(d.date)}</dd>
              <dt>Length</dt><dd>{d.readMinutes} min read</dd>
            </dl>
            <a class="btn" href="#subscribe">Subscribe free</a>
          </div>
        </div>
      </aside>
    </div>
  </article>

  <section class="wrap keep" aria-labelledby="more-title">
    <h2 id="more-title" class="hed h2">More issues</h2>
    {others.length > 0 ? (
      <ul class="grid keep__list">
        {others.map((i) => (
          <li>
            <a class="card" href={issueUrl(i)}>
              <div class="card__body">
                <p class="label">No. {i.data.number} · {i.data.topic}</p>
                <h3 class="hed h3">{i.data.title}</h3>
                <p class="dek" style="font-size:16px">{i.data.dek}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="sec-intro">This is the first issue. The next one arrives on a Sunday. <a class="link link--arrow" href="/archive/">Open the archive <Fragment set:html={ARROW} /></a></p>
    )}
  </section>
</Base>
